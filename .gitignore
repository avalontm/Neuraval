# ==== Neuraval.Samples.DinoGame (MonoGame) ====
# Salida compilada del pipeline de contenido (.mgcb) -- se regenera del
# Content.mgcb, no hace falta versionarla.
Neuraval.Samples.DinoGame/bin/
Neuraval.Samples.DinoGame/obj/
**/Content/bin/
**/Content/obj/

# ==== Checkpoints de entrenamiento (NEAT / MarioBridge) ====
# Estado binario de una corrida de entrenamiento particular (genomas,
# generacion, fitness). No es codigo ni configuracion -- es progreso local
# de cada quien, y ademas puede pesar bastante a medida que crecen los
# genomas. Si en algun momento queres compartir un checkpoint puntual,
# agregalo a mano con git add -f.
checkpoints/
*.navm
*.navm.bak
*.navm.*.incompatible-*
*.navm.*.corrupto.*
*.navm.*.header-invalido.*
*.navm.*.version-*-no-soportada.*

# ==== Savestates de BizHawk ====
# Viven fuera del repo por defecto (ver SAVESTATE_DIR en mario_bridge.lua),
# pero por si alguien los guarda adentro por error, no se versionan: son
# binarios grandes y especificos de la maquina/ROM de cada uno.
*.state
*.State

# ==== Datos de entrenamiento grandes ====
# Si Data/ empieza a tener datasets pesados, mejor no versionarlos por
# defecto. Los .txt chicos que ya estan trackeados (aritmetica.txt,
# generico.txt) no se ven afectados por este patron.
Data/*.bin
Data/*.csv

# ==== Sistema operativo / editores ====
.DS_Store
Thumbs.db
*.swp
*~
