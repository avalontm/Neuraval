<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Optimizaciones de rendimiento para entrenamiento en CPU -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neuraval.ChatBot\Neuraval.ChatBot.csproj" />
    <ProjectReference Include="..\Neuraval\Neuraval.csproj" />
    <ProjectReference Include="..\Neuraval.Abstractions\Neuraval.Abstractions.csproj" />
  </ItemGroup>

</Project>
